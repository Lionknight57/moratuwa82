---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CldImage from '../../components/CldImage.astro';
import { cldUrl } from '../../lib/cloudinary';
import { albums } from '../../data/albums';
import type { Album } from '../../data/albums';

// One page per album at /gallery/<slug>, built from the registry.
export async function getStaticPaths() {
  return albums.map((album) => ({ params: { album: album.slug }, props: { album } }));
}

const { album } = Astro.props as { album: Album };

// Anchor ids for titled sections, so /gallery/<album>/#<id> jumps straight
// there. Derived from the title rather than the index, so a link keeps working
// when sections are added or reordered above it. Untitled sections get no id
// and stay out of the jump list.
const slugify = (title: string) =>
  title
    .toLowerCase()
    .replace(/[^\p{L}\p{N}]+/gu, '-')
    .replace(/^-+|-+$/g, '')
    .slice(0, 60)
    .replace(/-+$/, '');

const usedIds = new Map<string, number>();
const sections = album.sections.map((section) => {
  if (!section.title) return { section, id: undefined };
  const base = slugify(section.title) || 'section';
  const n = (usedIds.get(base) ?? 0) + 1;
  usedIds.set(base, n);
  return { section, id: n === 1 ? base : `${base}-${n}` };
});

// Only worth showing when there is more than one place to jump to.
const toc = sections.filter((s) => s.id);

// Per-photo anchor, so a single photo can be linked to directly. Derived from
// the Cloudinary public ID (unique within an album) with the album prefix
// dropped. The "p-" guard matters: without it, the photo historical/graduation-day
// would collide with the section anchor #graduation-day.
const photoId = (publicId: string) =>
  'p-' +
  publicId
    .replace(/^[^/]+\//, '')
    .toLowerCase()
    .replace(/[^\p{L}\p{N}]+/gu, '-')
    .replace(/^-+|-+$/g, '');

// Alt text: the caption's first line reads as a description; the rest is a
// name list that would be noise in a screen reader's image announcement.
const altFor = (caption: string, sectionTitle?: string) =>
  caption.split('\n')[0] || sectionTitle || album.title;
---

<BaseLayout title={`${album.title} — Moratuwa 77'-82'`} description={album.summary}>
  <p class="crumb"><a href="/gallery/">← Gallery</a></p>
  <h1>{album.title}</h1>
  {album.intro && <p class="intro">{album.intro}</p>}

  {toc.length > 1 && (
    <nav class="toc" aria-labelledby="toc-label">
      <span class="toc-label" id="toc-label">Jump to</span>
      <ul>
        {toc.map((s) => (
          <li><a href={`#${s.id}`}>{s.section.title}</a></li>
        ))}
      </ul>
    </nav>
  )}

  {sections.map(({ section, id }) => (
    <section class="album-section" id={id}>
      {section.title && <h2>{section.title}</h2>}
      <div class="grid">
        {section.photos.map((photo) => (
          <figure id={photoId(photo.publicId)}>
            <a
              class="ph-link"
              href={cldUrl(photo.publicId, { width: 1600, crop: 'fit' })}
              data-caption={photo.caption}
            >
              <CldImage
                publicId={photo.publicId}
                alt={altFor(photo.caption, section.title)}
                width={600}
                height={450}
                sizes="(max-width: 700px) 100vw, 300px"
              />
            </a>
            {photo.caption && <figcaption>{photo.caption}</figcaption>}
          </figure>
        ))}
      </div>
    </section>
  ))}

  {album.closing && <p class="closing">{album.closing}</p>}

  <!-- Lightbox: enhanced by the script below; falls back to opening the image. -->
  <div id="lightbox" class="lb" role="dialog" aria-modal="true" aria-label="Photo viewer" hidden>
    <button class="lb-btn lb-close" type="button" aria-label="Close">&times;</button>
    <button class="lb-btn lb-prev" type="button" aria-label="Previous photo">&lsaquo;</button>
    <figure class="lb-stage">
      <div class="lb-imgwrap">
        <img class="lb-img" alt="" />
      </div>
      <figcaption class="lb-caption"></figcaption>
    </figure>
    <button class="lb-btn lb-next" type="button" aria-label="Next photo">&rsaquo;</button>
    <div class="lb-counter" aria-hidden="true"></div>
  </div>

  <style>
    h1 { border-bottom: 1px solid var(--border); padding-bottom: 0.4rem; }
    .crumb { margin: 0 0 0.5rem; font-size: 0.9rem; }
    .intro { color: var(--muted); }
    /* scroll-margin so a jumped-to heading isn't flush against the viewport. */
    .album-section { margin-top: 2.5rem; scroll-margin-top: 1rem; }

    .toc {
      margin: 1.5rem 0 0; padding: 0.85rem 1rem;
      background: var(--card); border: 1px solid var(--border); border-radius: 10px;
    }
    .toc-label {
      display: block; color: var(--muted); font-size: 0.75rem;
      text-transform: uppercase; letter-spacing: 0.04em; margin-bottom: 0.5rem;
    }
    .toc ul {
      list-style: none; margin: 0; padding: 0;
      display: flex; flex-wrap: wrap; gap: 0.35rem 1rem;
    }
    .toc li { max-width: 100%; }
    .toc a { font-size: 0.9rem; }
    @media (prefers-reduced-motion: no-preference) {
      html { scroll-behavior: smooth; }
    }
    .album-section h2 { font-size: 1.05rem; color: var(--fg); margin: 0 0 0.75rem; }
    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
      gap: 1rem;
    }
    /* Scoped to .grid so these thumbnail rules never reach the lightbox figure. */
    .grid figure { margin: 0; background: var(--card); border: 1px solid var(--border); border-radius: 10px; overflow: hidden; scroll-margin-top: 1rem; }
    .grid figure img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; }
    .ph-link { cursor: zoom-in; display: block; }
    .grid figcaption { padding: 0.6rem 0.75rem; color: var(--muted); font-size: 0.85rem; white-space: pre-line; }
    .closing { margin-top: 3rem; padding-top: 1.5rem; border-top: 1px solid var(--border); color: var(--muted); }

    /* Lightbox */
    .lb {
      position: fixed; inset: 0; z-index: 1000;
      display: flex; align-items: center; justify-content: center;
      background: rgba(0, 0, 0, 0.9);
      padding: 3.5rem 1rem 4.5rem;
    }
    .lb[hidden] { display: none; }
    .lb-stage {
      margin: 0; display: flex; flex-direction: column; align-items: center;
      gap: 0.75rem; width: min(1100px, 94vw); max-width: 94vw; height: 100%;
      background: none; border: none;
    }
    /* Fills the space the caption leaves, and can shrink so nothing clips. */
    .lb-imgwrap {
      flex: 1 1 auto; min-height: 0; width: 100%;
      display: flex; align-items: center; justify-content: center;
    }
    .lb-img {
      max-width: 100%; max-height: 100%;
      width: auto; height: auto; object-fit: contain;
      border-radius: 4px; background: #111;
    }
    .lb-caption {
      flex: 0 0 auto;
      color: #eee; font-size: 0.9rem; text-align: center; white-space: pre-line;
      max-width: 100%; max-height: 32vh; overflow-y: auto; padding: 0;
    }
    .lb-caption:empty { display: none; }
    .lb-btn {
      position: absolute; background: rgba(0, 0, 0, 0.4); color: #fff;
      border: 1px solid rgba(255, 255, 255, 0.25); border-radius: 50%;
      cursor: pointer; display: flex; align-items: center; justify-content: center;
      line-height: 1; padding: 0; transition: background 0.15s ease;
    }
    .lb-btn:hover { background: rgba(255, 255, 255, 0.2); }
    .lb-close { top: 1rem; right: 1rem; width: 2.6rem; height: 2.6rem; font-size: 1.6rem; }
    .lb-prev, .lb-next { top: 50%; transform: translateY(-50%); width: 3rem; height: 3rem; font-size: 2rem; }
    .lb-prev { left: 1rem; }
    .lb-next { right: 1rem; }
    .lb-counter {
      position: absolute; bottom: 1.25rem; left: 50%; transform: translateX(-50%);
      color: #cfcfcf; font-size: 0.85rem; letter-spacing: 0.03em;
    }
    @media (max-width: 560px) {
      .lb-prev { left: 0.35rem; } .lb-next { right: 0.35rem; }
      .lb-btn { background: rgba(0, 0, 0, 0.55); }
      .lb-img { max-height: 74vh; }
    }
  </style>

  <script>
    const links = Array.from(document.querySelectorAll('a.ph-link'));
    const lb = document.getElementById('lightbox');
    if (lb && links.length) {
      const img = lb.querySelector('.lb-img');
      const cap = lb.querySelector('.lb-caption');
      const counter = lb.querySelector('.lb-counter');
      let idx = 0;

      const preload = (i) => {
        const a = links[i];
        if (a) new Image().src = a.getAttribute('href');
      };

      const show = (i) => {
        idx = (i + links.length) % links.length;
        const a = links[idx];
        img.src = a.getAttribute('href');
        const c = a.dataset.caption || '';
        img.alt = c || 'Photo ' + (idx + 1);
        cap.textContent = c;
        counter.textContent = idx + 1 + ' / ' + links.length;
        preload(idx + 1);
        preload(idx - 1);
        if (!lb.hidden) syncHash(idx, false);
      };

      // --- Deep links -------------------------------------------------------
      // The address bar tracks the open photo, so it can be copied and shared;
      // loading such a URL opens that photo straight away. replaceState while
      // paging keeps 50 photos from filling the history.
      const idOf = (i) => (links[i].closest('figure') || {}).id || '';
      const bare = () => location.pathname + location.search;
      const syncHash = (i, push) => {
        const id = idOf(i);
        if (!id) return;
        const url = '#' + id;
        if (push) history.pushState({ photo: i }, '', url);
        else history.replaceState({ photo: i }, '', url);
      };
      const indexFromHash = () => {
        const h = decodeURIComponent(location.hash.slice(1));
        if (!h) return -1;
        return links.findIndex((a) => ((a.closest('figure') || {}).id || '') === h);
      };

      const open = (i, fromHash) => {
        show(i);
        lb.hidden = false;
        document.body.style.overflow = 'hidden';
        if (!fromHash) syncHash(idx, true);
      };
      const close = (keepHash) => {
        lb.hidden = true;
        document.body.style.overflow = '';
        img.src = '';
        if (!keepHash && indexFromHash() >= 0) history.replaceState(null, '', bare());
      };

      links.forEach((a, i) =>
        a.addEventListener('click', (e) => {
          e.preventDefault();
          open(i);
        }),
      );
      lb.querySelector('.lb-next').addEventListener('click', (e) => { e.stopPropagation(); show(idx + 1); });
      lb.querySelector('.lb-prev').addEventListener('click', (e) => { e.stopPropagation(); show(idx - 1); });
      lb.querySelector('.lb-close').addEventListener('click', () => close());
      lb.addEventListener('click', (e) => { if (e.target === lb || e.target.classList.contains('lb-stage')) close(); });

      document.addEventListener('keydown', (e) => {
        if (lb.hidden) return;
        if (e.key === 'Escape') close();
        else if (e.key === 'ArrowRight') show(idx + 1);
        else if (e.key === 'ArrowLeft') show(idx - 1);
      });

      // Touch swipe on the image. `swiping` guards against a touchend arriving
      // without its touchstart — otherwise the stale sx of 0 reads as a huge
      // swipe and silently jumps a photo.
      let sx = 0;
      let swiping = false;
      lb.addEventListener('touchstart', (e) => {
        sx = e.changedTouches[0].clientX;
        swiping = true;
      }, { passive: true });
      lb.addEventListener('touchend', (e) => {
        if (!swiping) return;
        swiping = false;
        const dx = e.changedTouches[0].clientX - sx;
        if (Math.abs(dx) > 45) show(idx + (dx < 0 ? 1 : -1));
      }, { passive: true });

      // Open whatever the URL points at, on load and on Back/Forward. A section
      // anchor matches no photo, so it just scrolls as before.
      const syncFromHash = () => {
        const i = indexFromHash();
        if (i >= 0) {
          if (lb.hidden) open(i, true);
          else show(i);
        } else if (!lb.hidden) {
          close(true);
        }
      };
      // popstate covers Back/Forward; hashchange covers a link to #p-… clicked
      // on the page itself, which does not fire popstate.
      window.addEventListener('popstate', syncFromHash);
      window.addEventListener('hashchange', syncFromHash);
      syncFromHash();
    }
  </script>
</BaseLayout>
