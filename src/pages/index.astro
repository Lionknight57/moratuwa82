---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { cldUrl } from '../lib/cloudinary';

const campusBg = cldUrl('site/moratuwa-campus', { width: 1200 });
const crest = cldUrl('site/uom-logo', { width: 240 });

// Every non-draft news item: pinned first, then newest by date. The list is
// scrollable rather than truncated — there is no /news/ index page, so anything
// cut here would be unreachable.
const news = (await getCollection('news', ({ data }) => !data.draft)).sort(
  (a, b) =>
    Number(b.data.pinned) - Number(a.data.pinned) ||
    b.data.date.valueOf() - a.data.date.valueOf(),
);

// Frontmatter dates are parsed as UTC midnight; format in UTC too so a date
// written as 2026-07-15 doesn't render as the 14th in a behind-UTC timezone.
const fmt = (d: Date) =>
  d.toLocaleDateString('en-GB', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
---

<BaseLayout title="Moratuwa 77'-82' — Home">
  <section class="hero">
    <div class="hero-banner" style={`background-image: url(${campusBg})`}></div>
    <img class="crest" src={crest} alt="University of Moratuwa crest" width="104" height="104" />
    <h1>Engineering Batch Moratuwa 77'-82'</h1>
    <p class="tagline">Photos and news for our batch.</p>
    <div class="cta">
      <a class="btn" href="/gallery/">Browse the gallery</a>
      <a class="btn ghost" href="/members/">See the members</a>
      <a class="btn ghost" href="/reunion-2027/">Reunion 2027</a>
    </div>
  </section>

  <section>
    <h2>Latest news</h2>
    <div class="news-scroll" tabindex="0" role="region" aria-label="Latest news">
      <ul class="news-list">
        {news.map((item) => (
          <li>
            <a href={item.data.link ?? `/news/${item.slug}/`}>
              <span class="date">{fmt(item.data.date)}</span>
              <span class="title">{item.data.title}</span>
            </a>
            {item.data.summary && <p class="summary">{item.data.summary}</p>}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <style>
    .hero {
      text-align: center;
      padding: 0 0 1.5rem;
    }
    .hero-banner {
      height: 190px;
      background-position: center;
      background-size: cover;
      background-repeat: no-repeat;
      border-radius: 12px;
      border: 1px solid var(--border);
    }
    .crest {
      width: 104px; height: 104px; object-fit: contain;
      background: #fff; border-radius: 16px; padding: 8px;
      border: 4px solid var(--bg);
      box-shadow: 0 3px 14px rgba(0, 0, 0, 0.18);
      display: block; margin: -62px auto 0.6rem;
      position: relative;
    }
    .hero h1 { font-size: clamp(2.2rem, 6vw, 3.5rem); margin: 0 0 0.25rem; }
    .tagline { color: var(--muted); font-size: 1.15rem; margin: 0 0 1.5rem; }
    .cta { display: flex; gap: 0.75rem; justify-content: center; flex-wrap: wrap; }
    .btn {
      display: inline-block; padding: 0.6rem 1.2rem; border-radius: 8px;
      background: var(--accent); color: #fff; text-decoration: none; font-weight: 600;
    }
    .btn.ghost { background: transparent; color: var(--accent); border: 1px solid var(--accent); }

    h2 { border-bottom: 1px solid var(--border); padding-bottom: 0.4rem; }
    /* Sized so the item at the fold is visibly cut in half — that clipping, not
       the scrollbar, is what tells people there is more news below. Padding on
       the right keeps text clear of the scrollbar. */
    .news-scroll {
      max-height: 24rem;
      overflow-y: auto;
      padding-right: 0.75rem;
      overscroll-behavior: contain;
      /* Keep the scrollbar visible rather than hover-revealed — it is the only
         hint that there is more news below the fold. */
      scrollbar-width: thin;
      scrollbar-color: var(--border) transparent;
    }
    .news-scroll::-webkit-scrollbar { width: 8px; }
    .news-scroll::-webkit-scrollbar-thumb {
      background: var(--border); border-radius: 4px;
    }
    .news-scroll:focus-visible { outline: 2px solid var(--accent); outline-offset: 4px; }
    .news-list { list-style: none; padding: 0; margin: 0; }
    .news-list li { padding: 1rem 0; border-bottom: 1px solid var(--border); }
    .news-list a { text-decoration: none; display: flex; gap: 0.75rem; flex-wrap: wrap; align-items: baseline; }
    .news-list .date { color: var(--muted); font-size: 0.85rem; min-width: 8rem; }
    .news-list .title { color: var(--fg); font-weight: 600; font-size: 1.1rem; }
    .news-list .summary { color: var(--muted); margin: 0.35rem 0 0; }
  </style>
</BaseLayout>
